# Copy to .env (git-ignored). Change every secret for anything beyond a local demo.
SOURCE_APP_PASSWORD=app-demo-password
SOURCE_DRIFTLESS_PASSWORD=driftless-demo-password
INDEX_DB_PASSWORD=index-demo-password
DRIFTLESS_ADMIN_TOKEN=demo-admin-token-change-me

# Host ports for the two databases (5433/5434 are often taken by other local Postgres instances)
SOURCE_DB_PORT=5443
INDEX_DB_PORT=5444

# Embeddings: Ollama on the host
OLLAMA_URL=http://host.docker.internal:11434
ARTICLES_EMBED_MODEL=nomic-embed-text
ARTICLES_EMBED_DIMS=768
ARTICLES_MAX_CHARS=2000
